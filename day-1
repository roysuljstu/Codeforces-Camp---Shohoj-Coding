2 .  A. Bit++ (282A)

#include<stdio.h>
int main (){
    int n ,x =0;
    scanf("%d",&n);
    char str[5];
    for(int i = 0;i<n;i++){
        scanf("%s", str);
    if(str[1] == '+')
        x++;
    else
        x--;
    }
    printf("%d\n",x);
return 0 ;
}


3.   A. Team (231A)

#include<stdio.h>
int main (){
    int n, count=0 ;
    scanf("%d",&n);
    for(int i =1;i<=n;i++ ){
        int p , v,t;
        scanf("%d %d %d",&p,&v,&t);
        if(p+v+t >= 2)
            count++;
    }
    printf("%d\n",count);
return 0;
}

4.  A. Way Too Long Words  (71A)

#include<stdio.h>
#include<string.h>
int main (){
    int n ;
    scanf("%d",&n);
    while(n--){
    char str[100] ,temp , ch ;
    scanf("%s",str);
    int i=0 , x ;
    x= strlen(str);
    if(x>10){
       temp =str[i];
       ch=str[x-1];
       x-=2;
       printf("%c%d%c\n",temp,x,ch);
    }
    else
        printf("%s\n",str);
 
    }
return 0;
}

5.    A. Next Round  ( 158A )



#include<stdio.h>
int main (){
    int n , k,count = 0 ;
    scanf("%d%d",&n,&k);
    int arr[n];
    for(int i=0;i<n;i++)
        scanf("%d",&arr[i]);
    int temp = arr[k-1];
    for(int i=0;i<n;i++)
        if(arr[i]>=temp && arr[i]>0)
            count++;
        printf("%d\n",count);
return 0 ;
}
